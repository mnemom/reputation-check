    "@actions/github": "^9.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@vercel/ncc": "^0.45.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.0.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.71.1"
  }
}
